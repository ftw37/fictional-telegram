diff --git a/src/video_core/amdgpu/command_copy.h b/src/video_core/amdgpu/command_copy.h
new file mode 100644
index 0000000..029f001
--- /dev/null
+++ b/src/video_core/amdgpu/command_copy.h
@@ -0,0 +1,29 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <algorithm>
+#include <atomic>
+#include <cstring>
+#include <memory>
+#include <span>
+#include <vector>
+#include "common/types.h"
+namespace AmdGpu {
+struct CommandCopy {
+    std::span<const u32> words;
+    std::unique_ptr<std::vector<u32>> owner;
+};
+// Never grow an arena whose data may be referenced by suspended command parsers.
+inline CommandCopy CopyCommands(std::span<const u32> source, std::vector<u32>& arena,
+                                std::atomic<u32>& offset) {
+    const size_t used = offset.load();
+    if (used > arena.capacity() || source.size() > arena.capacity() - used) {
+        auto owner = std::make_unique<std::vector<u32>>(source.begin(),source.end());
+        auto words = std::span<const u32>{*owner};
+        return {words,std::move(owner)};
+    }
+    arena.resize(std::max(arena.size(),used+source.size()));
+    if (!source.empty()) std::memcpy(arena.data()+used,source.data(),source.size_bytes());
+    offset = static_cast<u32>(used+source.size());
+    return {std::span<const u32>{arena.data()+used,source.size()}, {}};
+}
+}
