+// Version-checked HTL render leaf frame. Reserve real stack storage rather than
+// dropping the faulting draw or changing its algorithm. Only the known full body matches.
+bool ProtectHtlRenderLeaf(u64 base, u64 size) {
+#ifdef _WIN32
+    const char* enable = std::getenv("SHADPS4_HTL_LEAF_FRAME");
+    if (!enable || enable[0] != '1' || size < 0x1b74cad) return false;
+    auto* module = GetContainingModule(reinterpret_cast<void*>(base + 0x1b74520));
+    if (!module) return false;
+    std::scoped_lock lock{module->mutex};
+    auto* entry = reinterpret_cast<u8*>(base + 0x1b74520);
+    auto* exit = reinterpret_cast<u8*>(base + 0x1b74ca2);
+    constexpr std::array<u8,20> expected{0x76,0x25,0xcf,0x6a,0x4b,0xd7,0x8e,0x32,0x08,0x27,
+                                      0x08,0xf5,0x27,0x53,0x89,0x87,0x8f,0xed,0xb1,0xaa};
+    sha1::SHA1 hash;
+    sha1::SHA1::digest8_t digest;
+    hash.processBytes(entry, 1933).getDigestBytes(digest);
+    if (std::memcmp(digest, expected.data(), expected.size()) != 0) {
+        LOG_WARNING(Core, "HTL leaf-frame signature mismatch; no guest code changed");
+        return false;
+    }
+    std::array<u8,13> saved_entry;
+    std::array<u8,5> saved_exit;
+    std::memcpy(saved_entry.data(), entry, saved_entry.size());
+    std::memcpy(saved_exit.data(), exit, saved_exit.size());
+    using namespace Xbyak::util;
+    auto& trampoline = module->trampoline_gen;
+    const auto begin = trampoline.getSize();
+    try {
+        const auto* enter_stub = trampoline.getCurr();
+        trampoline.db(entry, 13); // unchanged frame pointer and five saved registers
+        trampoline.lea(rsp, ptr[rsp - 128]); // flag-preserving explicit red-zone reservation
+        trampoline.jmp(entry + 13);
+        const auto* exit_stub = trampoline.getCurr();
+        trampoline.lea(rsp, ptr[rsp + 128]);
+        trampoline.db(exit, 5); // original pop rbx/r12/r13
+        trampoline.jmp(exit + 5); // remaining original pops and ret
+        auto& patch = module->patch_gen;
+        patch.reset();
+        patch.setSize(entry - patch.getCode());
+        patch.jmp(enter_stub, Xbyak::CodeGenerator::LabelType::T_NEAR);
+        patch.nop(8);
+        patch.reset();
+        patch.setSize(exit - patch.getCode());
+        patch.jmp(exit_stub, Xbyak::CodeGenerator::LabelType::T_NEAR);
+        LOG_INFO(Core, "HTL render leaf: explicit 128-byte stack frame installed");
+        return true;
+    } catch (const Xbyak::Error& error) {
+        trampoline.setSize(begin);
+        std::memcpy(entry, saved_entry.data(), saved_entry.size());
+        std::memcpy(exit, saved_exit.data(), saved_exit.size());
+        LOG_ERROR(Core, "HTL leaf-frame trampoline failed; original code restored: {}", error.what());
+    }
+#endif
+    return false;
+}
