+    g_frame_counters.draws.Add();
+    if (FrameStatsLevel() > 1) {
+        std::scoped_lock lock{g_frame_listing.mutex};
+        if (g_frame_listing.state == Listing::Recording && !g_frame_listing.passes.empty()) {
+            ++g_frame_listing.passes.back().draws;
+        }
+    }
+}
