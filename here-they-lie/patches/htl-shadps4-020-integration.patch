diff --git a/src/core/vr/guest_frame_clock.cpp b/src/core/vr/guest_frame_clock.cpp
new file mode 100644
index 0000000..75d91a0
--- /dev/null
+++ b/src/core/vr/guest_frame_clock.cpp
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include <chrono>
+#include <condition_variable>
+#include <mutex>
+#include "common/types.h"
+namespace Core::GuestCpu {
+namespace {
+std::mutex frame_mutex;
+std::condition_variable frame_signal;
+u64 frame_count{};
+}
+void NoteGuestProgress() noexcept {
+    { std::scoped_lock lock{frame_mutex}; ++frame_count; }
+    frame_signal.notify_all();
+}
+u64 GuestFrameCount() noexcept {
+    std::scoped_lock lock{frame_mutex};
+    return frame_count;
+}
+u64 WaitForGuestFrame(u64 count, std::chrono::milliseconds timeout) {
+    std::unique_lock lock{frame_mutex};
+    frame_signal.wait_for(lock, timeout, [count] { return frame_count > count; });
+    return frame_count;
+}
+}
diff --git a/src/core/vr/headset_fov_cache.h b/src/core/vr/headset_fov_cache.h
new file mode 100644
index 0000000..ef26365
--- /dev/null
+++ b/src/core/vr/headset_fov_cache.h
@@ -0,0 +1,40 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <cmath>
+#include <optional>
+#include <nlohmann/json.hpp>
+
+#include "core/vr/vr_runtime.h"
+
+namespace Core::Vr {
+
+inline std::optional<Fov> CachedHeadsetFov(const nlohmann::json& json,
+                                           const HeadsetIdentity& identity) {
+    if (identity.runtime.empty() || identity.system.empty() || !json.is_object() ||
+        !json.contains("runtime") || json["runtime"] != identity.runtime ||
+        !json.contains("system") || json["system"] != identity.system ||
+        !json.contains("vendor_id") || json["vendor_id"] != identity.vendor_id ||
+        !json.contains("fov_tan")) {
+        return std::nullopt;
+    }
+    const auto& tangents = json["fov_tan"];
+    if (!tangents.is_array() || tangents.size() != 4) {
+        return std::nullopt;
+    }
+    for (const auto& tangent : tangents) {
+        if (!tangent.is_number()) {
+            return std::nullopt;
+        }
+        const float value = tangent.get<float>();
+        if (!std::isfinite(value) || value < 0.1f || value > 10.0f) {
+            return std::nullopt;
+        }
+    }
+    return Fov{tangents[0].get<float>(), tangents[1].get<float>(), tangents[2].get<float>(),
+               tangents[3].get<float>()};
+}
+
+}
diff --git a/src/core/vr/htl_diagnostics.h b/src/core/vr/htl_diagnostics.h
new file mode 100644
index 0000000..fee0a7a
--- /dev/null
+++ b/src/core/vr/htl_diagnostics.h
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <string>
+namespace Core::Vr {
+inline std::atomic_bool htl_sync_gpu{}, htl_sync_frame{}, htl_snapshot_constants{};
+inline std::atomic_bool htl_gpu_barrier{}, htl_clean_upload_fastpath{}, htl_exact_image_lookup{};
+inline std::atomic_bool htl_no_present{};
+inline std::atomic_int htl_barrier_mode{};
+inline void PollHtlDiagnostics() {
+    static const bool enabled = std::getenv("SHADPS4_HTL_COMPAT") != nullptr;
+    if (!enabled)
+        return;
+    static auto next = std::chrono::steady_clock::time_point{};
+    const auto now = std::chrono::steady_clock::now();
+    if (now < next)
+        return;
+    next = now + std::chrono::seconds(1);
+    std::error_code error;
+    htl_exact_image_lookup =
+        std::filesystem::exists("user/htl-exact-image-lookup", error);
+    htl_clean_upload_fastpath =
+        std::filesystem::exists("user/htl-clean-upload-fastpath", error);
+    const char* draw_sync = std::getenv("SHADPS4_HTL_DRAW_SYNC");
+    htl_sync_gpu = (draw_sync && draw_sync[0] == '1') ||
+                   std::filesystem::exists("user/htl-sync-gpu", error);
+    const char* gpu_barrier = std::getenv("SHADPS4_HTL_GPU_BARRIER");
+    htl_gpu_barrier = (gpu_barrier && gpu_barrier[0] == '1') ||
+                      std::filesystem::exists("user/htl-gpu-barrier", error);
+    const char* configured_mode = std::getenv("SHADPS4_HTL_BARRIER_MODE");
+    std::string mode = configured_mode ? configured_mode : "broad";
+    if (std::ifstream file{"user/htl-barrier-mode"}; file) file >> mode;
+    htl_barrier_mode = mode == "compute" ? 1 : mode == "pass" ? 2 :
+                       mode == "pipeline" ? 3 : mode == "state" ? 4 : 0;
+    const char* openxr = std::getenv("SHADPS4_OPENXR");
+    const char* no_present = std::getenv("SHADPS4_HTL_NO_PRESENT");
+    htl_no_present = openxr && openxr[0] == '0' &&
+        ((no_present && no_present[0] == '1') ||
+         std::filesystem::exists("user/htl-no-present", error));
+    const char* frame_sync = std::getenv("SHADPS4_HTL_FRAME_SYNC");
+    htl_sync_frame = (frame_sync && frame_sync[0] == '1') ||
+                     std::filesystem::exists("user/htl-sync-frame", error);
+    htl_snapshot_constants = std::filesystem::exists("user/htl-snapshot-constants", error);
+}
+} // namespace Core::Vr
diff --git a/src/core/vr/htl_timing.h b/src/core/vr/htl_timing.h
new file mode 100644
index 0000000..2fec278
--- /dev/null
+++ b/src/core/vr/htl_timing.h
@@ -0,0 +1,23 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <array>
+#include <cstring>
+#include <span>
+#include "common/types.h"
+namespace Core::Vr {
+inline constexpr size_t HtlFrameCapSite = 0x1e58ee9;
+inline constexpr std::array<u8, 26> HtlFrameCapOriginal{
+    0xc5,0xe9,0x57,0xd2,0xc5,0xf8,0x2e,0xc2,
+    0x0f,0x86,0x32,0x01,0x00,0x00,
+    0xc5,0xfa,0x10,0x1d,0x71,0xad,0x60,0x01,
+    0xc5,0xe2,0x5e,0xd8};
+// Preserve the original no-cap branch target and all following time calculations.
+inline bool ApplyHtlFrameCapBypass(std::span<u8> image) {
+    if (image.size() < HtlFrameCapSite + HtlFrameCapOriginal.size() ||
+        std::memcmp(image.data() + HtlFrameCapSite,
+                    HtlFrameCapOriginal.data(), HtlFrameCapOriginal.size()) != 0) return false;
+    constexpr std::array<u8, 6> jump{0xe9,0x33,0x01,0x00,0x00,0x90};
+    std::memcpy(image.data() + HtlFrameCapSite + 8, jump.data(), jump.size());
+    return true;
+}
+} // namespace Core::Vr
