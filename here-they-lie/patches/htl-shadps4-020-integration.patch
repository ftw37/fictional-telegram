+void Presenter::CaptureSocialFrame(const Libraries::VideoOut::BufferAttributeGroup& attribute,
+                                   VAddr address, std::function<void()> completed) {
+    auto desc = VideoCore::TextureCache::ImageDesc{attribute, address};
+    const auto id = texture_cache.FindImage(desc);
+    texture_cache.UpdateImage(id);
+    auto& image = texture_cache.GetImage(id);
+    draw_scheduler.EndRendering();
+    const auto cmdbuf = draw_scheduler.CommandBuffer();
+    image.Transit(vk::ImageLayout::eTransferSrcOptimal, vk::AccessFlagBits2::eTransferRead, {},
+                  cmdbuf);
+    auto readbacks = std::make_shared<std::vector<ScreenshotReadback>>();
+    readbacks->emplace_back(instance, draw_scheduler, ScreenshotKind::GameOnly,
+                            std::vector<std::filesystem::path>{}, image.info.size.width,
+                            image.info.size.height, image.info.pixel_format, false);
+    CopyImageToReadback(cmdbuf, image.GetImage(), vk::ImageLayout::eTransferSrcOptimal,
+                        readbacks->back());
+    image.Transit(vk::ImageLayout::eShaderReadOnlyOptimal, vk::AccessFlagBits2::eShaderRead, {},
+                  cmdbuf);
+    draw_scheduler.DeferPriorityOperation([readbacks, completed = std::move(completed)]() {
+        std::vector<u8> rgba;
+        const auto& image = readbacks->front();
+        if (ConvertReadbackToRgba8(image, rgba))
+            Core::Vr::PublishSocialPreview(rgba, image.width, image.height, {1.f, 1.f, 0.f, 0.f},
+                                           true);
+        completed();
+    });
+    draw_scheduler.Flush();
+}
