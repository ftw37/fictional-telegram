diff --git a/src/video_core/renderer_vulkan/vk_occlusion.cpp b/src/video_core/renderer_vulkan/vk_occlusion.cpp
new file mode 100644
index 0000000..ff2c582
--- /dev/null
+++ b/src/video_core/renderer_vulkan/vk_occlusion.cpp
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include <deque>
+#include <mutex>
+#include "common/logging/log.h"
+#include "core/memory.h"
+#include "video_core/renderer_vulkan/vk_instance.h"
+#include "video_core/renderer_vulkan/vk_occlusion.h"
+#include "video_core/renderer_vulkan/vk_scheduler.h"
+namespace Vulkan {
+struct OcclusionCounters::State {
+    const Instance& instance;
+    vk::UniqueQueryPool pool;
+    std::mutex mutex;
+    std::deque<u32> free;
+    // Only the scheduler's FIFO priority callback thread updates this counter.
+    u64 counter{};
+    vk::QueryControlFlags control{};
+    bool host_reset{};
+    explicit State(const Instance& instance_) : instance{instance_} {
+        constexpr u32 Count = 8192;
+        if (instance.GetPhysicalDevice().getFeatures().occlusionQueryPrecise)
+            control = vk::QueryControlFlagBits::ePrecise;
+        pool = instance.GetDevice().createQueryPoolUnique(vk::QueryPoolCreateInfo{
+            .queryType = vk::QueryType::eOcclusion, .queryCount = Count}).value;
+        const auto features = instance.GetPhysicalDevice().getFeatures2<
+            vk::PhysicalDeviceFeatures2, vk::PhysicalDeviceVulkan12Features>();
+        host_reset = features.get<vk::PhysicalDeviceVulkan12Features>().hostQueryReset;
+        if (host_reset) instance.GetDevice().resetQueryPool(*pool, 0, Count);
+        for (u32 i = 0; i < Count; ++i) free.push_back(i);
+        LOG_INFO(Render_Vulkan, "GPU visibility counter host reset: {}", host_reset);
+    }
+};
+OcclusionCounters::OcclusionCounters(const Instance& instance, Scheduler& scheduler_)
+    : state{std::make_shared<State>(instance)}, scheduler{scheduler_} {}
+void OcclusionCounters::BeginSegment(bool inside_rendering) {
+    if (!recording || active || inside_rendering != state->host_reset) return;
+    {
+        std::scoped_lock lock{state->mutex};
+        if (state->free.empty()) {
+            overflow = true;
+            return;
+        }
+        active = state->free.front();
+        state->free.pop_front();
+    }
+    if (!state->host_reset) scheduler.EndRendering();
+    const auto cmd = scheduler.CommandBuffer();
+    if (!state->host_reset) cmd.resetQueryPool(*state->pool, *active, 1);
+    cmd.beginQuery(*state->pool, *active, state->control);
+}
+void OcclusionCounters::EndSegment() {
+    if (!active) return;
+    // Host-reset slots are queried inside one rendering instance. The fallback
+    // keeps both boundaries outside rendering and within one command buffer.
+    if (!state->host_reset) scheduler.EndRendering();
+    scheduler.CommandBuffer().endQuery(*state->pool, *active);
+    segments.push_back(*active);
+    active.reset();
+}
+void OcclusionCounters::EndRenderingSegment() {
+    if (state->host_reset) EndSegment();
+}
+void OcclusionCounters::WriteCounter(VAddr address, u32 pairs) {
+    EndSegment();
+    recording = true;
+    auto completed = std::move(segments);
+    segments.clear();
+    const bool lost = overflow;
+    overflow = false;
+    // Wait off the command processor. CPU/GPU guest polls must not prevent results
+    // from being delivered, and all snapshots must retain their submission order.
+    scheduler.DeferPriorityOperation([shared = state, completed = std::move(completed), address, pairs, lost] {
+        u64 increment = lost ? 1 : 0; // Pool exhaustion conservatively keeps objects visible.
+        for (const u32 slot : completed) {
+            u64 samples{};
+            const auto result = shared->instance.GetDevice().getQueryPoolResults(
+                *shared->pool, slot, 1, sizeof(samples), &samples, sizeof(samples),
+                vk::QueryResultFlagBits::e64);
+            if (result == vk::Result::eSuccess) increment += samples;
+            else {
+                ++increment;
+                LOG_ERROR(Render_Vulkan, "Occlusion result unavailable after its GPU fence: {}", vk::to_string(result));
+            }
+        }
+        static u32 result_logs = 0;
+        if (result_logs++ < 32) {
+            LOG_INFO(Render_Vulkan, "HTL occlusion result: address={:#x} segments={} samples={} overflow={}",
+                address, completed.size(), increment, lost);
+        }
+        shared->counter = (shared->counter + increment) & 0x7fffffffffffffffULL;
+        constexpr u64 Valid = 0x8000000000000000ULL;
+        auto* memory = Core::Memory::Instance();
+        for (u32 i = 0; i < pairs; ++i) {
+            const u64 value = Valid | (i == 0 ? shared->counter : 0);
+            const VAddr target = address + i * 16;
+            if (memory->IsValidMapping(target, sizeof(value))) {
+                memory->TryWriteBacking(reinterpret_cast<void*>(target), &value, sizeof(value));
+            }
+        }
+        if (shared->host_reset) {
+            for (const u32 slot : completed)
+                shared->instance.GetDevice().resetQueryPool(*shared->pool, slot, 1);
+        }
+        std::scoped_lock lock{shared->mutex};
+        for (const u32 slot : completed) shared->free.push_back(slot);
+    });
+}
+}
diff --git a/src/video_core/renderer_vulkan/vk_occlusion.h b/src/video_core/renderer_vulkan/vk_occlusion.h
new file mode 100644
index 0000000..f6c56c1
--- /dev/null
+++ b/src/video_core/renderer_vulkan/vk_occlusion.h
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <memory>
+#include <optional>
+#include <vector>
+#include "common/types.h"
+namespace Vulkan {
+class Instance;
+class Scheduler;
+// Counter snapshots, rather than assumed query pairs, also support nested guest tests.
+class OcclusionCounters {
+public:
+    OcclusionCounters(const Instance& instance, Scheduler& scheduler);
+    void BeginSegment(bool inside_rendering);
+    void EndRenderingSegment();
+    void EndSegment();
+    void WriteCounter(VAddr address, u32 pairs);
+private:
+    struct State;
+    std::shared_ptr<State> state;
+    Scheduler& scheduler;
+    std::optional<u32> active;
+    std::vector<u32> segments;
+    bool recording{};
+    bool overflow{};
+};
+}
