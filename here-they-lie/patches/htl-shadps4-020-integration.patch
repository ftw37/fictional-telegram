+                        std::chrono::steady_clock::now() - start)
+                        .count();
+    g_call_ns[static_cast<size_t>(call)].fetch_add(static_cast<u64>(ns), std::memory_order_relaxed);
+    g_call_count[static_cast<size_t>(call)].fetch_add(1, std::memory_order_relaxed);
