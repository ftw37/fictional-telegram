 namespace Libraries::Kernel {
 
+// Opt-in guest sleep profiling. Reports aggregate waits, not one log per call.
+class HtlSleepTrace {
+    using Clock = std::chrono::steady_clock;
+    struct Count { u64 calls{}, requested_ns{}, elapsed_ns{}; };
+public:
+    HtlSleepTrace(const char* api_, const void* caller_, u64 requested_)
+        : api{api_}, caller{reinterpret_cast<uintptr_t>(caller_)}, requested{requested_} {
+        static const bool configured = [] {
+            const char* value = std::getenv("SHADPS4_HTL_SLEEP_TRACE");
+            const char* compat = std::getenv("SHADPS4_HTL_COMPAT");
+            return value && value[0] == '1' && compat && compat[0] == '1';
+        }();
+        enabled = configured;
+        if (enabled) start = Clock::now();
+    }
+    ~HtlSleepTrace() {
+        if (!enabled) return;
+        const auto now = Clock::now();
+        static thread_local std::map<std::pair<const char*, uintptr_t>, Count> counts;
+        static thread_local auto since = now;
+        auto& count = counts[{api, caller}];
+        ++count.calls;
+        count.requested_ns += requested;
+        count.elapsed_ns += std::chrono::duration_cast<std::chrono::nanoseconds>(now - start).count();
+        if (now - since < std::chrono::seconds{5}) return;
+        const auto name = Common::GetCurrentThreadName();
+        const double seconds = std::chrono::duration<double>(now - since).count();
+        for (const auto& [key, value] : counts) {
+            LOG_INFO(Lib_Kernel, "HTL_SLEEP thread={} api={} caller={:#x} calls={} interval={:.3f}s requested={:.3f}ms elapsed={:.3f}ms",
+                     name, key.first, key.second, value.calls, seconds,
+                     value.requested_ns / 1e6, value.elapsed_ns / 1e6);
+        }
+        counts.clear();
+        since = now;
+    }
+private:
+    const char* api;
+    uintptr_t caller;
+    u64 requested;
+    Clock::time_point start{};
+    bool enabled{};
+};
+
 static u64 initial_ptc;
 static std::unique_ptr<Common::NativeClock> clock;
 
