+
+inline u16 Le16(const u8* p) {
+    return u16(p[0]) | (u16(p[1]) << 8);
+}
+inline u32 Le32(const u8* p) {
+    return u32(p[0]) | (u32(p[1]) << 8) | (u32(p[2]) << 16) | (u32(p[3]) << 24);
+}
+inline u32 Be32(const u8* p) {
+    return (u32(p[0]) << 24) | (u32(p[1]) << 16) | (u32(p[2]) << 8) | u32(p[3]);
+}
+
+inline std::optional<Layout> Describe(const Format& format) {
+    if (!format.channels || format.channels > 8 || !format.rate || format.rate > 384000)
+        return {};
+    if (format.type == 0x40) {
+        // LibAtrac9's configuration reader indexes a six-entry channel table directly.
+        if ((format.config >> 24) != 0xfe || ((format.config >> 17) & 7) >= 6 ||
+            (format.config & 0x10000))
+            return {};
+        std::array<u8, 4> config{u8(format.config >> 24), u8(format.config >> 16),
+                                 u8(format.config >> 8), u8(format.config)};
+        void* decoder = Atrac9GetHandle();
+        if (!decoder)
+            return {};
+        Atrac9CodecInfo info{};
+        const bool valid = Atrac9InitDecoder(decoder, config.data()) == 0 &&
+                           Atrac9GetCodecInfo(decoder, &info) == 0 &&
+                           info.channels == format.channels && info.samplingRate == format.rate &&
+                           info.superframeSize > 0 && info.frameSamples > 0 &&
+                           info.framesInSuperframe > 0;
+        Atrac9ReleaseHandle(decoder);
+        if (!valid)
+            return {};
+        return Layout{u32(info.superframeSize), u32(info.frameSamples * info.framesInSuperframe),
+                      u32(info.framesInSuperframe), u32(info.frameSamples)};
