+                        readbacks->back());
+    image.Transit(vk::ImageLayout::eShaderReadOnlyOptimal, vk::AccessFlagBits2::eShaderRead, {},
+                  cmdbuf);
+    draw_scheduler.DeferPriorityOperation([readbacks, completed = std::move(completed)]() {
+        std::vector<u8> rgba;
+        const auto& image = readbacks->front();
