diff --git a/shadps4-arm64-main/src/core/vr/htl_diagnostics.h b/shadps4-arm64-main/src/core/vr/htl_diagnostics.h
new file mode 100644
index 0000000..ccd017f
--- /dev/null
+++ b/shadps4-arm64-main/src/core/vr/htl_diagnostics.h
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <string>
+namespace Core::Vr {
+inline std::atomic_bool htl_sync_gpu{}, htl_sync_frame{}, htl_snapshot_constants{};
+inline std::atomic_bool htl_gpu_barrier{};
+inline std::atomic_bool htl_no_present{};
+inline std::atomic_int htl_barrier_mode{};
+inline void PollHtlDiagnostics() {
+    static const bool enabled = std::getenv("SHADPS4_HTL_COMPAT") != nullptr;
+    if (!enabled)
+        return;
+    static auto next = std::chrono::steady_clock::time_point{};
+    const auto now = std::chrono::steady_clock::now();
+    if (now < next)
+        return;
+    next = now + std::chrono::seconds(1);
+    std::error_code error;
+    const char* draw_sync = std::getenv("SHADPS4_HTL_DRAW_SYNC");
+    htl_sync_gpu = (draw_sync && draw_sync[0] == '1') ||
+                   std::filesystem::exists("user/htl-sync-gpu", error);
+    const char* gpu_barrier = std::getenv("SHADPS4_HTL_GPU_BARRIER");
+    htl_gpu_barrier = (gpu_barrier && gpu_barrier[0] == '1') ||
+                      std::filesystem::exists("user/htl-gpu-barrier", error);
+    const char* configured_mode = std::getenv("SHADPS4_HTL_BARRIER_MODE");
+    std::string mode = configured_mode ? configured_mode : "broad";
+    if (std::ifstream file{"user/htl-barrier-mode"}; file) file >> mode;
+    htl_barrier_mode = mode == "compute" ? 1 : mode == "pass" ? 2 :
+                       mode == "pipeline" ? 3 : mode == "state" ? 4 : 0;
+    const char* openxr = std::getenv("SHADPS4_OPENXR");
+    const char* no_present = std::getenv("SHADPS4_HTL_NO_PRESENT");
+    htl_no_present = openxr && openxr[0] == '0' &&
+        ((no_present && no_present[0] == '1') ||
+         std::filesystem::exists("user/htl-no-present", error));
+    const char* frame_sync = std::getenv("SHADPS4_HTL_FRAME_SYNC");
+    htl_sync_frame = (frame_sync && frame_sync[0] == '1') ||
+                     std::filesystem::exists("user/htl-sync-frame", error);
+    htl_snapshot_constants = std::filesystem::exists("user/htl-snapshot-constants", error);
+}
+} // namespace Core::Vr
