+
+namespace Libraries::Ngs2::Waveform {
+
+struct Format {
+    u32 type{}, channels{}, rate{}, config{}, delay{};
+};
+struct Layout {
+    u32 bytes{}, samples{}, units{1}, delay{};
+};
+struct Parsed {
+    Format format;
+    Layout layout;
+    u32 offset{}, bytes{}, samples{}, loop_begin{}, loop_end{};
+};
+struct Block {
+    u32 offset{}, bytes{}, skip{}, samples{};
