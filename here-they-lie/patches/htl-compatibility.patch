+void Rasterizer::ApplyHtlGpuBarrier(const Pipeline* pipeline) {
+    if (!Core::Vr::htl_gpu_barrier.load(std::memory_order_relaxed)) {
+        return;
+    }
+    const int mode = Core::Vr::htl_barrier_mode.load(std::memory_order_relaxed);
+    static int logged_mode = -1;
+    if (logged_mode != mode) {
+        logged_mode = mode;
+        LOG_INFO(Render_Vulkan, "HTL GPU dependency mode {}", mode);
+    }
+    if (mode == 3 || mode == 4) {
+        scheduler.ForgetGraphicsPipeline();
+        if (mode == 4) scheduler.GetDynamicState().Invalidate();
+        return;
+    }
+    if (mode == 1) {
+        bool writes = pipeline->IsCompute();
+        for (const auto* stage : pipeline->GetStages()) {
+            if (!stage) continue;
+            for (const auto& buffer : stage->buffers) writes |= buffer.is_written;
+            for (const auto& image : stage->images) writes |= image.is_written || image.is_atomic;
+        }
+        const bool needs_dependency = htl_memory_write_pending || writes;
+        htl_memory_write_pending = writes;
+        if (!needs_dependency) return;
+    }
+    scheduler.EndRendering();
+    if (mode == 2) return;
+    const vk::MemoryBarrier2 barrier{
+        .srcStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+        .srcAccessMask = vk::AccessFlagBits2::eMemoryRead | vk::AccessFlagBits2::eMemoryWrite,
+        .dstStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+        .dstAccessMask = vk::AccessFlagBits2::eMemoryRead | vk::AccessFlagBits2::eMemoryWrite,
+    };
+    scheduler.CommandBuffer().pipelineBarrier2(vk::DependencyInfo{
+        .memoryBarrierCount = 1, .pMemoryBarriers = &barrier});
+}
