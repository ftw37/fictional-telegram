+    0x0f,0x86,0x32,0x01,0x00,0x00,
+    0xc5,0xfa,0x10,0x1d,0x71,0xad,0x60,0x01,
+    0xc5,0xe2,0x5e,0xd8};
+// Preserve the original no-cap branch target and all following time calculations.
+inline bool ApplyHtlFrameCapBypass(std::span<u8> image) {
+    if (image.size() < HtlFrameCapSite + HtlFrameCapOriginal.size() ||
+        std::memcmp(image.data() + HtlFrameCapSite,
+                    HtlFrameCapOriginal.data(), HtlFrameCapOriginal.size()) != 0) return false;
+    constexpr std::array<u8, 6> jump{0xe9,0x33,0x01,0x00,0x00,0x90};
+    std::memcpy(image.data() + HtlFrameCapSite + 8, jump.data(), jump.size());
+    return true;
+}
+} // namespace Core::Vr
