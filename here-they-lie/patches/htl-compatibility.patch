+void Presenter::CaptureSocialFrame(const Libraries::VideoOut::BufferAttributeGroup& attribute,
+                                   VAddr address, std::function<void()> completed) {
+    auto desc = VideoCore::TextureCache::ImageDesc{attribute, address};
