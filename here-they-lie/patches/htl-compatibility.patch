+        break;
+    case 0x14:
+    case 0x15:
+        bytes = 3;
+        break;
+    case 0x16:
+    case 0x17:
+    case 0x18:
+    case 0x19:
+        bytes = 4;
+        break;
+    case 0x1a:
+    case 0x1b:
+        bytes = 8;
+        break;
+    default:
+        return {};
+    }
+    return Layout{bytes * format.channels, 1, 1, 0};
+}
+
+// Chunk lengths are checked before making subspans. Outputs are published only on success.
+inline std::optional<Parsed> Parse(std::span<const u8> input) {
+    if (input.size() < 12 || std::memcmp(input.data(), "RIFF", 4) ||
+        std::memcmp(input.data() + 8, "WAVE", 4))
+        return {};
+    const u64 end = u64(Le32(input.data() + 4)) + 8;
+    if (end < 12 || end > input.size() || end > std::numeric_limits<u32>::max())
+        return {};
+    std::span<const u8> fmt, fact, smpl, audio;
+    u32 audio_offset = 0;
+    for (u64 at = 12; at < end;) {
+        if (end - at < 8)
+            return {};
+        const auto* header = input.data() + at;
+        const u32 length = Le32(header + 4);
+        if (length > end - at - 8)
+            return {};
+        const auto chunk = input.subspan(size_t(at + 8), length);
+        if (!std::memcmp(header, "fmt ", 4)) {
+            if (!fmt.empty())
+                return {};
+            fmt = chunk;
+        } else if (!std::memcmp(header, "data", 4)) {
+            if (!audio.empty())
+                return {};
+            audio = chunk;
+            audio_offset = u32(at + 8);
+        } else if (!std::memcmp(header, "fact", 4)) {
+            fact = chunk;
+        } else if (!std::memcmp(header, "smpl", 4)) {
+            smpl = chunk;
+        }
+        at += 8 + u64(length) + (length & 1);
+        if (at > end)
+            return {};
+    }
+    if (fmt.size() < 16 || audio.empty())
+        return {};
+    Parsed parsed{};
+    auto& format = parsed.format;
+    format.channels = Le16(fmt.data() + 2);
+    format.rate = Le32(fmt.data() + 4);
+    const u16 bits = Le16(fmt.data() + 14);
+    u16 tag = Le16(fmt.data());
+    if (tag == 0xfffe) {
+        if (fmt.size() < 40 || Le16(fmt.data() + 16) < 22 ||
+            u32(Le16(fmt.data() + 16)) + 18 > fmt.size())
+            return {};
+        constexpr std::array<u8, 16> At9Guid{0xd2, 0x42, 0xe1, 0x47, 0xba, 0x36, 0x8d, 0x4d,
+                                             0x88, 0xfc, 0x61, 0x65, 0x4f, 0x8c, 0x83, 0x6c};
+        constexpr std::array<u8, 12> PcmGuidTail{0, 0,    0x10, 0,    0x80, 0,
+                                                 0, 0xaa, 0,    0x38, 0x9b, 0x71};
+        if (!std::memcmp(fmt.data() + 24, At9Guid.data(), At9Guid.size())) {
+            if (fmt.size() < 52 || Le16(fmt.data() + 16) < 34 || Le32(fmt.data() + 40) != 1)
+                return {};
+            format.type = 0x40;
+            format.config = Be32(fmt.data() + 44);
+        } else if (!std::memcmp(fmt.data() + 28, PcmGuidTail.data(), PcmGuidTail.size())) {
+            const u32 subtag = Le32(fmt.data() + 24);
+            if (subtag != 1 && subtag != 3)
+                return {};
+            tag = u16(subtag);
+        } else {
+            return {};
+        }
+    }
+    if (!format.type) {
+        if (tag == 1) {
+            switch (bits) {
+            case 8:
+                format.type = 0x11;
+                break;
+            case 16:
+                format.type = 0x12;
+                break;
+            case 24:
+                format.type = 0x14;
+                break;
+            case 32:
+                format.type = 0x16;
+                break;
+            default:
+                return {};
+            }
+        } else if (tag == 3 && (bits == 32 || bits == 64)) {
+            format.type = bits == 32 ? 0x18 : 0x1a;
+        } else {
+            return {};
+        }
+    }
+    const auto layout = Describe(format);
+    if (!layout || Le16(fmt.data() + 12) != layout->bytes || audio.size() % layout->bytes)
+        return {};
+    parsed.layout = *layout;
+    format.delay =
+        format.type == 0x40 ? (fact.size() >= 12 ? Le32(fact.data() + 8) : layout->delay) : 0;
+    const u64 available = u64(audio.size() / layout->bytes) * layout->samples;
+    if (format.delay >= available)
+        return {};
+    const u64 samples = fact.size() >= 4 ? Le32(fact.data()) : available - format.delay;
+    if (!samples || samples > available - format.delay || samples > std::numeric_limits<u32>::max())
+        return {};
+    parsed.offset = audio_offset;
+    parsed.bytes = u32(audio.size());
+    parsed.samples = u32(samples);
+    if (smpl.size() >= 60 && Le32(smpl.data() + 28) == 1 && Le32(smpl.data() + 40) == 0) {
+        const u64 begin = Le32(smpl.data() + 44);
+        const u64 finish = u64(Le32(smpl.data() + 48)) + 1;
+        if (begin >= format.delay && finish > begin && finish - format.delay <= samples) {
+            parsed.loop_begin = u32(begin - format.delay);
+            parsed.loop_end = u32(finish - format.delay);
+        }
+    }
+    return parsed;
+}
+
+inline std::optional<Block> CalculateBlock(const Format& format, u32 start, u32 count) {
+    const auto layout = Describe(format);
+    if (!layout || !count)
+        return {};
+    const u64 sample = u64(start) + format.delay;
+    u64 first = sample / layout->samples;
+    // A preceding superframe warms the ATRAC9 overlap for a seek into the stream.
+    if (format.type == 0x40 && first)
+        --first;
+    const u64 skip = sample - first * layout->samples;
+    const u64 units = (skip + count + layout->samples - 1) / layout->samples;
+    const u64 offset = first * layout->bytes;
+    const u64 bytes = units * layout->bytes;
+    constexpr u64 Max = std::numeric_limits<u32>::max();
+    if (offset > Max || bytes > Max || skip > Max || offset + bytes > Max)
+        return {};
+    return Block{u32(offset), u32(bytes), u32(skip), count};
+}
+
+} // namespace Libraries::Ngs2::Waveform
