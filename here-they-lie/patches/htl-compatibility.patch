diff --git a/shadps4-arm64-main/src/core/vr/social_preview.h b/shadps4-arm64-main/src/core/vr/social_preview.h
new file mode 100644
index 0000000..25baf45
--- /dev/null
+++ b/shadps4-arm64-main/src/core/vr/social_preview.h
@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <mutex>
+#include <vector>
+#include "common/types.h"
+namespace Core::Vr {
+struct SocialPreviewFrame {
+    u32 width{}, height{};
+    u64 serial{};
+    bool actual{};
+    std::vector<u8> rgba;
+};
+inline std::mutex social_preview_mutex;
+inline SocialPreviewFrame social_preview_frame;
+inline std::chrono::steady_clock::time_point social_actual_until;
+inline void PublishSocialPreview(const std::vector<u8>& rgba, u32 width, u32 height,
+                                 std::array<float, 4> uv, bool actual = false) {
+    if (!width || !height || rgba.size() < static_cast<size_t>(width) * height * 4)
+        return;
+    const u32 x = std::min(width - 1, static_cast<u32>(width * uv[2]));
+    const u32 y = std::min(height - 1, static_cast<u32>(height * uv[3]));
+    u32 w = std::clamp(static_cast<u32>(width * uv[0]), 1u, width - x);
+    u32 h = std::clamp(static_cast<u32>(height * uv[1]), 1u, height - y);
+    u32 top = y;
+    if (!actual && h > w * 9 / 16) {
+        const u32 cropped = std::max(1u, w * 9 / 16);
+        top += (h - cropped) / 2;
+        h = cropped;
+    }
+    SocialPreviewFrame frame;
+    frame.width = w;
+    frame.height = h;
+    frame.actual = actual;
+    frame.rgba.resize(static_cast<size_t>(w) * h * 4);
+    for (u32 row = 0; row < h; ++row)
+        std::copy_n(rgba.data() + (static_cast<size_t>(top + row) * width + x) * 4, w * 4,
+                    frame.rgba.data() + static_cast<size_t>(row) * w * 4);
+    std::scoped_lock lock(social_preview_mutex);
+    const auto now = std::chrono::steady_clock::now();
+    if (!actual && now < social_actual_until)
+        return;
+    if (actual)
+        social_actual_until = now + std::chrono::seconds(2);
+    frame.serial = social_preview_frame.serial + 1;
+    social_preview_frame = std::move(frame);
+}
+} // namespace Core::Vr
diff --git a/shadps4-arm64-main/src/core/vr/startup_calibration.h b/shadps4-arm64-main/src/core/vr/startup_calibration.h
new file mode 100644
index 0000000..bb86031
--- /dev/null
+++ b/shadps4-arm64-main/src/core/vr/startup_calibration.h
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <algorithm>
+
+namespace Core::Vr {
+// One startup Options hold after focused, tracked game frames are available.
+// Losing focus before the hold restarts the countdown; losing it during the hold
+// cancels the attempt permanently, so returning later cannot pause gameplay.
+class StartupCalibration {
+public:
+    bool Update(double seconds, bool ready) {
+        if (done) {
+            return false;
+        }
+        if (!ready) {
+            done = holding;
+            elapsed = 0.0;
+            previous = -1.0;
+            return false;
+        }
+        if (previous >= 0.0) {
+            elapsed += std::clamp(seconds - previous, 0.0, 0.1);
+        }
+        previous = seconds;
+        if (elapsed >= 5.0) {
+            done = true;
+            return false;
+        }
+        holding = elapsed >= 3.0;
+        return holding;
+    }
+private:
+    double previous{-1.0};
+    double elapsed{};
+    bool holding{};
+    bool done{};
+};
+} // namespace Core::Vr
diff --git a/shadps4-arm64-main/src/core/vr/theatre_mode.h b/shadps4-arm64-main/src/core/vr/theatre_mode.h
new file mode 100644
index 0000000..1f02050
--- /dev/null
+++ b/shadps4-arm64-main/src/core/vr/theatre_mode.h
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <atomic>
+#include <cstdlib>
+#include <cstdint>
+
+namespace Core::Vr {
+inline bool TheatreEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("SHADPS4_HTL_THEATRE");
+        return value && value[0] == '1';
+    }();
+    return enabled;
+}
+// Low bit: flat theatre. Upper bits: transition generation, rejecting queued old images.
+inline std::atomic<std::uint64_t>& PresentationStateStorage() {
+    static std::atomic<std::uint64_t> state{1};
+    return state;
+}
+inline std::uint64_t PresentationState() {
+    return TheatreEnabled() ? PresentationStateStorage().load() : 0;
+}
+inline bool IsTheatre(std::uint64_t state) { return (state & 1) != 0; }
+inline void SetTheatre(bool theatre) {
+    if (!TheatreEnabled()) return;
+    auto& storage = PresentationStateStorage();
+    auto old = storage.load();
+    while (IsTheatre(old) != theatre &&
+           !storage.compare_exchange_weak(old, ((old & ~std::uint64_t{1}) + 2) |
+                                                  std::uint64_t{theatre})) {}
+}
+} // namespace Core::Vr
